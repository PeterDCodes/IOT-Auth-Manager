ADMIN_KEY="my-apisix-admin-key"
# Service key is required for APISIX JWT auth plug in to device the name of service. Currently this needs to match the ISSUER
# The KEY is essentially the signal that APISIX needs so it knows which consumer you intend to check the JWT against.
# EX: A JWT is signed with the Key - "Peter-auth", then APISIX knows to check this against the "Peter-auth" consumer credential
SERVICE_KEY="IOT-AUTH-MANAGER"
PUB_KEY_PATH="./public.pem"

# DB Settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=1234

# Device Registration - Requires an admin password to register new devices
REGISTRATION_CODE=1234

# JWT Token Settings
JWT_PRIVATE_KEY_PATH=./private.pem
JWT_PUBLIC_KEY_PATH=./public.pem
EXPIRES_IN=15m
ISSUER="IOT-AUTH-MANAGER"
AUDIENCE="IOT_DEVICE"