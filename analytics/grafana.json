                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT d.ds_device_name AS device, d.ds_serial_number AS serial_number, da.device_uuid, da.fl_active AS active, da.dt_authenticated AS authenticated_at, da.dt_last_refresh AS last_refresh, CASE WHEN NOT da.fl_active THEN 'Inactive' WHEN da.dt_last_refresh IS NULL THEN 'Never refreshed' ELSE 'Refreshed' END AS jwt_status FROM device_authentication da JOIN device d ON d.device_uuid = da.device_uuid ORDER BY da.dt_last_refresh DESC NULLS LAST, da.dt_authenticated DESC;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
