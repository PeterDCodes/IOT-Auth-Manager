                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT dd.cd_deployment AS deployment_id, dd.dt_record AS deployed_at, dd.cd_location AS location_id, dd.cd_production_line AS production_line, dd.ds_project AS project, dd.ds_owner AS owner, d.ds_device_name AS device_name, d.device_uuid, d.ds_asset_code AS asset_code, dt.ds_type AS device_type, dm.ds_model AS device_model, dm.ds_vendor AS vendor, d.ds_serial_number AS serial_number, d.ds_mac_address AS mac_address, d.ds_ip_addr AS ip_address, COALESCE(da.fl_active, FALSE) AS auth_active, da.dt_last_refresh AS last_jwt_refresh FROM device_deployment dd LEFT JOIN device d ON d.device_uuid = dd.device_uuid LEFT JOIN device_type dt ON dt.cd_device_type = d.cd_device_type LEFT JOIN device_model dm ON dm.cd_device_model = d.cd_device_model LEFT JOIN device_authentication da ON da.device_uuid = d.device_uuid ORDER BY dd.cd_location NULLS LAST, dd.cd_production_line NULLS LAST, d.ds_device_name;"
