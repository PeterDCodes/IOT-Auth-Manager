JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=client-register
JWT_AUDIENCE=device-apis
EXPIRES_IN=15m
REGISTRATION_CODE=replace-with-a-private-enrollment-code
PGHOST=localhost
PGPORT=5432
PGDATABASE=devices
PGUSER=postgres
PGPASSWORD=replace-with-your-password

# Recommended for separate services: replace HS256 and JWT_SECRET with these values.
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=./private.pem
# JWT_PUBLIC_KEY_PATH=./public.pem
